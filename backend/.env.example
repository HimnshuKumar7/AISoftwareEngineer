# Copy this file to ".env" and fill in the provider you want to use.

# Which LLM powers the Planner / Reasoner / Final Answer nodes.
# Options: ollama | groq | gemini | openai
LLM_PROVIDER=ollama

# --- Ollama (100% local & free, recommended to start) ---
# Install from https://ollama.com, then: ollama pull qwen2.5-coder:7b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# --- Groq (free hosted tier, fast) https://console.groq.com ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Gemini (free hosted tier) https://aistudio.google.com/apikey ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- OpenAI (paid) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Embeddings are always local & free via sentence-transformers, no key needed.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Neon Postgres (stores users, indexed repos, and query history) ---
# From your Neon project -> Connection Details -> "Connection string" (pooled
# connection is fine). It already includes sslmode=require.
DATABASE_URL=postgresql://neondb_owner:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# --- JWT auth ---
# Generate a real secret with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRE_MINUTES=10080
