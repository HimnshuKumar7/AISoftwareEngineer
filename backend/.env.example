# ---------- General ----------
ENVIRONMENT=development        # set to "production" on Render (enables strict secret/DB checks)
LOG_LEVEL=INFO

# ---------- Database: Neon PostgreSQL ----------
# Neon console -> Connection Details. Use the *pooled* or direct string, with sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
AUTO_CREATE_TABLES=true        # creates tables on boot; or run schema.sql manually and set false

# ---------- Auth ----------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ---------- CORS ----------
# Exact frontend origin(s), comma separated, NO trailing slash.
CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app
# Optional: also allow Vercel preview deployments
# CORS_ORIGIN_REGEX=https://your-app-.*\.vercel\.app

# ---------- LLM provider (pick one; embeddings are unaffected) ----------
LLM_PROVIDER=groq              # ollama | groq | gemini | openai
LLM_MODEL=                     # blank = provider default (see app/llm/providers.py)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=               # e.g. http://localhost:11434 (must be reachable from the backend host)

# ---------- Resource limits (defaults suit Render free tier, 512 MB RAM) ----------
MAX_REPOS_PER_USER=5
MAX_REPO_SIZE_MB=150
MAX_FILES_PER_REPO=1500
MAX_FILE_SIZE_KB=256
MAX_CHUNKS_PER_REPO=6000
EMBEDDING_BATCH_SIZE=16
MODEL_CACHE_DIR=./models
